# No trailing slash: a `node_modules` symlink must be ignored too, not just a directory.
node_modules
dist/
*.log
.DS_Store
.env
.env.*
!.env.example
evidence/local/
var/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.acp-secrets/

# node-gyp build output for in-tree native addons (ADR-0010). CI produces this fresh on
# macos-15; only the source (binding.gyp, src/*.cc) is checked in.
native/*/build/

# A delegate writes its report here; it is never part of the repository.
HANDOFF-REPORT.md
evidence/junit.xml
