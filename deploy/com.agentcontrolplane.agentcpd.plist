<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd definition for agentcpd (PRD §33.1).

  Install with:
    cp deploy/com.agentcontrolplane.agentcpd.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.agentcontrolplane.agentcpd.plist

  ThrottleInterval gives the supervisor's own crash-loop backoff; the daemon records
  consecutive start refusals in ~/.agent-control-plane/crash-loop.json so a loop is
  visible in evidence rather than silent.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentcontrolplane.agentcpd</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>REPLACE_WITH_ABSOLUTE_PATH/dist/daemon/agentcpd.js</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>REPLACE_WITH_HOME/.agent-control-plane/agentcpd.out.log</string>

  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_HOME/.agent-control-plane/agentcpd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- The Buzz relay credential belongs to the daemon only; it is never forwarded to
         an agent session or a verification subprocess (PRD §33.3). -->
    <key>BUZZ_RELAY_URL</key>
    <string>http://localhost:3000</string>
  </dict>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>
</dict>
</plist>
