<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentcontrolplane.agentcpd</string>

  <!-- Rendered by install-launchd.sh. No checked-in plist is loadable as a daemon. -->
  <key>ProgramArguments</key>
  <array>
    <string>__ACP_LAUNCHER__</string>
  </array>

  <!-- O4b B' — the raw-Mach launch service a driven turn's credential is handed over on. launchd holds
       this name's receive right for the job and hands it to the daemon via bootstrap_check_in at start,
       so a same-uid process cannot check it in first (step 1: kr=1100). The name is fixed, derived from
       the Label the way every reserved name is, and matches MACH_LAUNCH_RESERVED_SERVICE in the daemon.
       It demand-launches the job; the daemon checks it in only after its database admission passes, so a
       #738-refused daemon (which exits first) is never relaunched into serving by a Mach request. -->
  <key>MachServices</key>
  <dict>
    <key>com.agentcontrolplane.agentcpd.launch</key>
    <true/>
  </dict>

  <key>WorkingDirectory</key>
  <string>__ACP_WORKING_DIRECTORY__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>ProcessType</key>
  <string>Standard</string>

  <key>StandardOutPath</key>
  <string>__ACP_STDOUT_PATH__</string>

  <key>StandardErrorPath</key>
  <string>__ACP_STDERR_PATH__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Secrets are fetched by the owner-only launcher from Keychain at process start. -->
    <key>HOME</key>
    <string>__ACP_HOME__</string>
    <key>PATH</key>
    <string>__ACP_PATH__</string>
    <!-- Only this plist sets it: a database refusal then exits 0, the #738 stop signal to KeepAlive. -->
    <key>ACP_DAEMON_SUPERVISOR</key>
    <string>launchd</string>
  </dict>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>
</dict>
</plist>
