{
  "name": "agent-control-plane",
  "version": "1.0.0",
  "private": true,
  "description": "Single local runtime authority that turns managed project intent into verified production-ready results",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "agentctl": "./dist/cli/agentctl.js",
    "agentcpd": "./dist/daemon/agentcpd.js",
    "agentcpd-state": "./dist/db/state-admin.js"
  },
  "scripts": {
    "postinstall": "node scripts/build-native-peercred.mjs",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest-gate.mjs",
    "test:unit": "vitest run tests/unit",
    "test:scenarios": "vitest run tests/scenarios",
    "test:e2e": "vitest run tests/e2e --testTimeout=600000",
    "acceptance:disposable-realm": "NODE_DISABLE_COMPILE_CACHE=1 node --experimental-transform-types scripts/run-disposable-realm-probe.ts",
    "lint": "eslint .",
    "trace": "tsx src/tools/traceability.ts",
    "terminology": "node scripts/verify-terminology.mjs",
    "reason-codes": "node scripts/verify-reason-codes.mjs",
    "reason-codes:usage": "node scripts/verify-reason-code-usage.mjs",
    "scripts:plausible-callers": "node scripts/verify-every-script-has-a-plausible-caller.mjs",
    "evidence:freshness": "node scripts/verify-evidence-freshness.mjs",
    "invariants": "node scripts/verify-invariant-coverage.mjs",
    "buzz:contract": "tsx scripts/verify-buzz-cli-contract.ts",
    "release:version": "node scripts/verify-release-version.mjs",
    "symbols": "node scripts/verify-enforcement-symbols.mjs",
    "adapter:source": "node scripts/verify-acceptance-adapter-source.mjs",
    "guards:falsifiable": "node scripts/verify-guards-are-falsifiable.mjs",
    "guards:anchors": "node scripts/verify-guards-are-falsifiable.mjs --anchors-only",
    "guards:peercred-unreachable": "node scripts/verify-peercred-is-unreachable.mjs",
    "native:peercred:build": "node scripts/build-native-peercred.mjs",
    "hooks:check": "node scripts/verify-hooks-are-installed.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "trailers": "node scripts/verify-trailers-are-parsable.mjs",
    "merge": "node scripts/merge-pr.mjs",
    "migrations:check": "node scripts/verify-migrations-are-immutable.mjs",
    "migrations:freeze": "node scripts/verify-migrations-are-immutable.mjs --update",
    "schema:census": "node scripts/verify-append-only-tables-are-closed.mjs",
    "schema:writers": "node scripts/verify-turn-fence-writer-census.mjs",
    "schema:denials": "node scripts/verify-trigger-denials-are-typed.mjs",
    "schema:registry": "node scripts/verify-every-trigger-is-required.mjs",
    "guards:operands": "node scripts/verify-refusal-operands-are-watched.mjs",
    "verify:fresh-database": "tsx scripts/verify-fresh-database.ts",
    "probe:daemon-startup": "tsx scripts/probe-daemon-startup.ts",
    "ssot:report": "node scripts/ssot-report.mjs",
    "review:grok": "node scripts/grok-review.mjs",
    "review:production": "node scripts/production-review.mjs",
    "review:file-majors": "node scripts/file-review-majors.mjs",
    "file:open-work": "node scripts/file-open-work.mjs",
    "close:evidence": "node scripts/close-with-evidence.mjs",
    "sync:issues": "node scripts/sync-issues.mjs",
    "buzz:capture-live": "npx tsx scripts/capture-buzz-live.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "11.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "4.1.11"
  }
}
