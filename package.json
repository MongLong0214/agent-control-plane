{
  "name": "agent-control-plane",
  "version": "1.3.0",
  "private": true,
  "description": "Single local runtime authority that turns managed project intent into verified production-ready results",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentctl": "./dist/cli/agentctl.js",
    "agentcpd": "./dist/daemon/agentcpd.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:scenarios": "vitest run tests/scenarios",
    "test:e2e": "vitest run tests/e2e --testTimeout=600000",
    "lint": "eslint .",
    "trace": "tsx src/tools/traceability.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
