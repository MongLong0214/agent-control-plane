{
  "name": "agent-control-plane",
  "version": "1.0.0",
  "private": true,
  "description": "Single local runtime authority that turns managed project intent into verified production-ready results",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentctl": "./dist/cli/agentctl.js",
    "agentcpd": "./dist/daemon/agentcpd.js",
    "agentcpd-state": "./dist/db/state-admin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:scenarios": "vitest run tests/scenarios",
    "test:e2e": "vitest run tests/e2e --testTimeout=600000",
    "lint": "eslint .",
    "trace": "tsx src/tools/traceability.ts",
    "terminology": "node scripts/verify-terminology.mjs",
    "evidence:freshness": "node scripts/verify-evidence-freshness.mjs",
    "invariants": "node scripts/verify-invariant-coverage.mjs",
    "buzz:contract": "tsx scripts/verify-buzz-cli-contract.ts",
    "release:version": "node scripts/verify-release-version.mjs",
    "symbols": "node scripts/verify-enforcement-symbols.mjs",
    "adapter:parity": "node scripts/verify-adapter-option-parity.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
