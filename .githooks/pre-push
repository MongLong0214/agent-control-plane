#!/bin/sh
# Refuse a push whose falsifiability rows no longer name lines that exist.
#
# Twice on 2026-08-22 a push went out while the full sweep was still running locally, and CI came
# back red for a row that matched nothing — the same class both times, and both times the answer
# was already on this machine a minute after the edit that broke it.
#
# The full sweep is over an hour and is not a pre-push check; the anchors pass is a string search
# and is. It cannot tell you a guard is tested. It can tell you a row stopped checking anything,
# which is what CI failed on.
#
# What this hook deliberately does *not* run is `pnpm gates` — the whole CI gate set, about three
# minutes (#739). It is three minutes because it includes the suite, and a hook that costs that on
# every push to a work-in-progress branch is a hook people remove. Run it yourself before a push
# you expect to be reviewed: it is the same manifest and the same executor CI uses, so a green
# `pnpm gates` is the answer CI would give, and #736's `pnpm lint` failure arrives in five seconds
# instead of after a push and a wait.
#
# 2026-09-15: that last paragraph was advice, and advice is not a gate. The same class was met
# four times in one session -- tests/process, a stale subprocess exclusion, an unnarrowed
# Decision, an unused parameter -- each time by a gate the author would not have picked, and each
# time about a *removal*, which is the shape a diff shows least. The advice had been read.
#
# So the three minutes are now charged where they buy something and nowhere else: a push to a
# branch with an open pull request is a push someone will review, and it requires a green
# `pnpm gates` on the exact commit being pushed. A work-in-progress branch with no pull request
# still costs only the anchors pass, which is what keeps this hook installed.
set -e

# Read what git is actually pushing before deciding anything. `pre-push` receives one line per ref
# on stdin -- `<local ref> <local sha> <remote ref> <remote sha>` -- and this hook used to ignore
# it, asking `HEAD` instead. Two things followed, both met on 2026-09-15:
#
#   * a notes-only push (`git push origin refs/notes/commitlore`) carries no commit and cannot
#     change what CI judges, and it was refused for want of a gate receipt. The records this
#     repository exists to keep could not be published because of the gate that guards its code;
#   * the sha checked was `HEAD`, not the commit being pushed, so pushing a ref that is not the
#     current branch asked about the wrong commit.
#
# A push with nothing under `refs/heads/` is not this hook's subject. Deletions are excluded by
# their all-zero local sha: they carry no tree for a row to name and no commit for CI to judge.
pushed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  case "$local_sha" in *[!0]*) pushed="$pushed $local_ref:$local_sha" ;; esac
done
if [ -z "$pushed" ]; then
  exit 0
fi

if ! node scripts/verify-guards-are-falsifiable.mjs --anchors-only; then
  echo "pre-push: a falsifiability row no longer names a line that exists." >&2
  echo "CI runs this before the build; it will fail there in seconds. Fix the row first." >&2
  exit 1
fi

# `gh` absent, or no pull request, or the lookup failing: this is a work-in-progress push and the
# receipt is not required. Deliberately fail-open on the *question* and fail-closed on the
# *answer* -- an unavailable lookup must not block work, but once a pull request is known to
# exist an absent receipt refuses.
#
# `--json state` and not `--json number`: `gh pr view` answers for a MERGED pull request exactly as
# it does for an open one, so a branch whose pull request has already landed kept demanding a
# receipt for every later push -- forever, on a branch nobody will review again. Only an OPEN pull
# request means someone will read this.
open_pull_request() {
  command -v gh >/dev/null 2>&1 || return 1
  [ -n "${1:-}" ] || return 1
  [ "$(gh pr view "$1" --json state --jq .state 2>/dev/null)" = "OPEN" ]
}

# What is required is that the manifest was **run** against this commit, not that it was green.
# Green is not available everywhere: #895 pins the qualified executor at 2.1.268 while this
# machine's PATH `claude` has moved on, so `wake-transport-qualification` fails locally forever
# and CI skips that file. A hook demanding green would refuse every reviewed push permanently,
# which is how a hook becomes a `--no-verify` habit -- the warning light that never turns off,
# which this file's own comment already argues against.
#
# Running it is what was actually missed, four times in one session. A recorded run puts the
# failures in front of the author before the push; judging them stays with the author, and CI
# still has the last word.
receipt="$(git rev-parse --absolute-git-dir)/acp-gates-receipt"
for entry in $pushed; do
  branch="${entry%%:*}"
  branch="${branch#refs/heads/}"
  sha="${entry##*:}"
  open_pull_request "$branch" || continue
  # The commit being pushed, not `HEAD`. They are the same for the ordinary push and
  # different for every other one, and the receipt names a commit.
  if [ ! -f "$receipt" ] || ! grep -q "\"$sha\"" "$receipt"; then
    echo "pre-push: $branch has an open pull request, so CI will judge it." >&2
    echo "  \`pnpm gates\` has not been run against $sha." >&2
    echo "" >&2
    echo "  Run it -- same manifest, same order, same executor CI uses:" >&2
    echo "    pnpm build && pnpm gates" >&2
    echo "" >&2
    echo "  Four failures in one session were in gates nobody would have picked: tests/process," >&2
    echo "  guards:subprocess-bounds, tsc over vitest, and lint. All four were about a removal," >&2
    echo "  which is the shape a diff shows least." >&2
    echo "  Registered as \`pushed-without-the-gate-manifest\` in src/quality/recurring-defects.ts." >&2
    exit 1
  fi
  failed="$(sed -n 's/.*"failed":"\([^"]*\)".*/\1/p' "$receipt")"
  if [ -n "$failed" ]; then
    echo "pre-push: \`pnpm gates\` was run against $sha and stopped at \`$failed\`." >&2
    echo "  Pushing anyway. CI will reach the same gate -- this is here so it is not a surprise." >&2
  fi
done
