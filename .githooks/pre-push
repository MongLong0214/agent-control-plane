#!/bin/sh
# Refuse a push whose falsifiability rows no longer name lines that exist.
#
# Twice on 2026-08-22 a push went out while the full sweep was still running locally, and CI came
# back red for a row that matched nothing — the same class both times, and both times the answer
# was already on this machine a minute after the edit that broke it.
#
# The full sweep is over an hour and is not a pre-push check; the anchors pass is a string search
# and is. It cannot tell you a guard is tested. It can tell you a row stopped checking anything,
# which is what CI failed on.
#
# What this hook deliberately does *not* run is `pnpm gates` — the whole CI gate set, about three
# minutes (#739). It is three minutes because it includes the suite, and a hook that costs that on
# every push to a work-in-progress branch is a hook people remove. Run it yourself before a push
# you expect to be reviewed: it is the same manifest and the same executor CI uses, so a green
# `pnpm gates` is the answer CI would give, and #736's `pnpm lint` failure arrives in five seconds
# instead of after a push and a wait.
#
# 2026-09-15: that last paragraph was advice, and advice is not a gate. The same class was met
# four times in one session -- tests/process, a stale subprocess exclusion, an unnarrowed
# Decision, an unused parameter -- each time by a gate the author would not have picked, and each
# time about a *removal*, which is the shape a diff shows least. The advice had been read.
#
# So the three minutes are now charged where they buy something and nowhere else: a push to a
# branch with an open pull request is a push someone will review, and it requires a green
# `pnpm gates` on the exact commit being pushed. A work-in-progress branch with no pull request
# still costs only the anchors pass, which is what keeps this hook installed.
set -e
if ! node scripts/verify-guards-are-falsifiable.mjs --anchors-only; then
  echo "pre-push: a falsifiability row no longer names a line that exists." >&2
  echo "CI runs this before the build; it will fail there in seconds. Fix the row first." >&2
  exit 1
fi

# `gh` absent, or no pull request, or the lookup failing: this is a work-in-progress push and the
# receipt is not required. Deliberately fail-open on the *question* and fail-closed on the
# *answer* -- an unavailable lookup must not block work, but once a pull request is known to
# exist an absent receipt refuses.
review_branch() {
  command -v gh >/dev/null 2>&1 || return 1
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 1
  gh pr view "$branch" --json number >/dev/null 2>&1
}

if review_branch; then
  receipt="$(git rev-parse --absolute-git-dir)/acp-gates-green"
  head="$(git rev-parse HEAD)"
  if [ ! -f "$receipt" ] || [ "$(cat "$receipt")" != "$head" ]; then
    echo "pre-push: this branch has an open pull request, so CI will judge it." >&2
    echo "  No green \`pnpm gates\` is recorded for $head." >&2
    echo "" >&2
    echo "  Run it -- same manifest, same order, same executor CI uses:" >&2
    echo "    pnpm build && pnpm gates" >&2
    echo "" >&2
    echo "  Four failures in one session were in gates chosen by nobody: tests/process," >&2
    echo "  guards:subprocess-bounds, tsc over vitest, and lint. All four were about a removal." >&2
    echo "  Registered as \`pushed-without-the-gate-manifest\` in src/quality/recurring-defects.ts." >&2
    exit 1
  fi
fi
