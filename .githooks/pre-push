#!/bin/sh
# Refuse a push whose falsifiability rows no longer name lines that exist.
#
# Twice on 2026-08-22 a push went out while the full sweep was still running locally, and CI came
# back red for a row that matched nothing — the same class both times, and both times the answer
# was already on this machine a minute after the edit that broke it.
#
# The full sweep is over an hour and is not a pre-push check; the anchors pass is a string search
# and is. It cannot tell you a guard is tested. It can tell you a row stopped checking anything,
# which is what CI failed on.
#
set -e

# Read what git is actually pushing before deciding anything. `pre-push` receives one line per ref
# on stdin -- `<local ref> <local sha> <remote ref> <remote sha>` -- and this hook used to ignore
# it, asking `HEAD` instead. Two things followed, both met on 2026-09-15:
#
#   * a notes-only push (`git push origin refs/notes/commitlore`) carries no commit and cannot
#     change what CI judges, and it was refused for want of a gate receipt. The records this
#     repository exists to keep could not be published because of the gate that guards its code;
#   * the sha checked was `HEAD`, not the commit being pushed, so pushing a ref that is not the
#     current branch asked about the wrong commit.
#
# A push with nothing under `refs/heads/` is not this hook's subject. Deletions are excluded by
# their all-zero local sha: they carry no tree for a row to name and no commit for CI to judge.
pushed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  case "$local_sha" in *[!0]*) pushed="$pushed $local_ref:$local_sha" ;; esac
done
if [ -z "$pushed" ]; then
  exit 0
fi

if ! node scripts/verify-guards-are-falsifiable.mjs --anchors-only; then
  echo "pre-push: a falsifiability row no longer names a line that exists." >&2
  echo "CI runs this before the build; it will fail there in seconds. Fix the row first." >&2
  exit 1
fi
